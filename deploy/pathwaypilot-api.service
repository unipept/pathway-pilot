# PathwayPilot backend API.
#
# Install:
#   sudo cp deploy/pathwaypilot-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pathwaypilot-api
#
# Logs:    journalctl -u pathwaypilot-api -f
# Restart: sudo systemctl restart pathwaypilot-api

[Unit]
Description=PathwayPilot backend API
Documentation=https://github.com/unipept/pathway-pilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pathwaypilot
Group=pathwaypilot

WorkingDirectory=/opt/pathwaypilot/backend
EnvironmentFile=/opt/pathwaypilot/backend/.env
ExecStart=/usr/bin/node build/index.js

# The mapping tables are built at import time and take a while on this
# dataset, so give startup room before deciding the unit has failed.
TimeoutStartSec=300

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pathwaypilot-api

# The service only ever reads its own tree and writes nothing at runtime.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pathwaypilot/backend/data

[Install]
WantedBy=multi-user.target
