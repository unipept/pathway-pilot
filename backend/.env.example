# Copy this file to `.env` and adjust if needed:
#
#   cp .env.example .env
#
# Every variable below is required. The backend reads them in
# src/config/config.ts and will not start if any is missing.
# The defaults here work against the data files committed in backend/data/.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3000
HOSTNAME=pathwaypilot.ugent.be

# ---------------------------------------------------------------------------
# KEGG API
#
# BASE is prefixed to each of the three endpoints below.
# PATHWAY resolves to e.g. https://www.kegg.jp/pathway/map00053
# PATHWAY_PNG resolves to e.g. https://www.kegg.jp/kegg/pathway/map/map00053@2x.png
# ---------------------------------------------------------------------------

KEGG_API_ENDPOINT__BASE=https://www.kegg.jp/
KEGG_API_ENDPOINT__PATHWAY=pathway/
KEGG_API_ENDPOINT__PATHWAY_PNG=kegg/pathway/map/
KEGG_API_ENDPOINT__PATHWAY_NAMES=list/pathway/

# ---------------------------------------------------------------------------
# Data directories
#
# Both are resolved relative to the backend/ directory and must end in a slash.
# ---------------------------------------------------------------------------

DATA_DIR=data/
LINK_DIR=data/link/

# ---------------------------------------------------------------------------
# Data files (relative to DATA_DIR)
# ---------------------------------------------------------------------------

EC_DATA_FILE=ec
KO_DATA_FILE=ko
REACTION_DATA_FILE=reaction
COMPOUND_DATA_FILE=compound
MODULE_DATA_FILE=module
PATHWAY_DATA_FILE=pathway

# ---------------------------------------------------------------------------
# Link files (relative to LINK_DIR)
# ---------------------------------------------------------------------------

EC_KO_LINK_FILE=ec2ko
EC_REACTION_LINK_FILE=ec2reaction
EC_COMPOUND_LINK_FILE=ec2compound
EC_PATHWAY_LINK_FILE=ec2pathway
EC_MODULE_LINK_FILE=ec2module

KO_REACTION_LINK_FILE=ko2reaction
KO_PATHWAY_LINK_FILE=ko2pathway
KO_MODULE_LINK_FILE=ko2module

REACTION_COMPOUND_LINK_FILE=reaction2compound
REACTION_PATHWAY_LINK_FILE=reaction2pathway
REACTION_MODULE_LINK_FILE=reaction2module

COMPOUND_PATHWAY_LINK_FILE=compound2pathway
COMPOUND_MODULE_LINK_FILE=compound2module
